{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "ysysoftworks.net" }],
      "dest": "/under-construction.html",
      "headers": { "Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.ysysoftworks.net" }],
      "dest": "/under-construction.html",
      "headers": { "Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow" }
    },
    { "handle": "filesystem" }
  ]
}
